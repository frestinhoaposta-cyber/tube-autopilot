PORT=3000
# No Windows local, os serviços forçam HOST=127.0.0.1 e não expõem a porta.
# Em nuvem, use HOST=0.0.0.0 (o modo postgres já usa esse valor por padrão).
HOST=127.0.0.1
PERSISTENCE_DRIVER=local
# Produção: postgres. Os dois processos devem usar o mesmo banco, bucket e chave.
# O schema é fixo no código: tube_autopilot (tabelas autopilot_documents/autopilot_sessions).
DATABASE_URL=
DATA_DIR=data

# Bucket privado compatível com S3. O acervo atual tem ~3,41 GB: use um plano gratuito
# com espaço suficiente (Cloudflare R2: 10 GB, Backblaze B2: 10 GB). Não use File Storage do Supabase.
S3_BUCKET=
S3_REGION=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# B2: https://s3.<REGIAO>.backblazeb2.com
# AWS: vazio
S3_ENDPOINT=
# true para R2/B2; false para AWS.
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Somente para comandos explícitos de migração/backup.
LEGACY_DATA_DIR=data
MIGRATION_BACKUP_DIR=data/backups/render
BACKUP_PATH=
SESSION_SECRET=troque-por-uma-frase-grande-e-aleatoria

# Autenticação do painel.
# single: usuário único, sem Supabase Auth; use o MESMO userId já dono dos canais/OAuth.
# supabase: modo multi-usuário original; exige SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY.
# O Blueprint do Render define AUTH_MODE=single; o padrão local continua supabase.
AUTH_MODE=supabase
SINGLE_USER_ID=
SINGLE_USER_EMAIL=administrador
# Senha do painel no modo single; mínimo de 12 caracteres. Nunca commitar o valor real.
PANEL_PASSWORD=

# Supabase Auth — somente quando AUTH_MODE=supabase.
# Crie o projeto em https://supabase.com/ e pegue as chaves em Project Settings > API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Chave de criptografia dos tokens OAuth em disco (AES-256-GCM).
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 2º cliente OAuth do YouTube (opcional — use um projeto SEPARADO no Google Cloud
# para ter uma cota diária de upload própria). Na conexão, escolha o cliente.
YOUTUBE_CLIENT_ID_2=
YOUTUBE_CLIENT_SECRET_2=
YOUTUBE_REDIRECT_URI_2=http://localhost:3000/api/auth/google/callback

# TikTok Login Kit + Content Posting API
# Crie um app em https://developers.tiktok.com/ e habilite Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/auth/callback

# Editor automático de vídeos (FFmpeg)
# Opcional: aponte para binários próprios. Sem isso, usa os pacotes instalados pelo npm.
FFMPEG_PATH=
FFPROBE_PATH=
# Onde ficam os vídeos editados e os arquivos de configuração/fila.
EDITED_VIDEOS_DIR=data/edited
EDITOR_SETTINGS_PATH=data/editor-settings.json
EDITOR_JOBS_PATH=data/editor-jobs.json
