PORT=3000
SESSION_SECRET=troque-por-uma-frase-grande-e-aleatoria

# Supabase Auth (multi-usuário)
# Crie o projeto em https://supabase.com/ e pegue as chaves em Project Settings > API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Chave de criptografia dos tokens OAuth em disco (AES-256-GCM).
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 2º cliente OAuth do YouTube (opcional — use um projeto SEPARADO no Google Cloud
# para ter uma cota diária de upload própria). Na conexão, escolha o cliente.
YOUTUBE_CLIENT_ID_2=
YOUTUBE_CLIENT_SECRET_2=
YOUTUBE_REDIRECT_URI_2=http://localhost:3000/api/auth/google/callback

# TikTok Login Kit + Content Posting API
# Crie um app em https://developers.tiktok.com/ e habilite Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/auth/callback
