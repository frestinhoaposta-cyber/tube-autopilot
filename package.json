{
  "name": "tube-autopilot",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "worker": "node server/worker.js",
    "worker:local": "node server/local-worker.js",
    "service:web": "node scripts/run-service.js --service web",
    "service:worker": "node scripts/run-service.js --service worker",
    "migrate:shared": "node server/migrate-shared.js",
    "backup:shared": "node server/backup-shared.js",
    "backup:local": "node scripts/backup-local.js",
    "verify:backup:local": "node scripts/backup-local.js --verify",
    "restore:shared": "node server/restore-shared.js",
    "validate:render": "node scripts/validate-render.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@supabase/supabase-js": "^2.112.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
